[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
[user]
	name = Jared Duquette
	email = jared@digitalduquette.com
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDu6q+Pn52EjVWQTF43UZrbzATXDmRCLkRKhp39IgpcJ
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
